def matryoshka_negative_sampling(predictions_dict,label_2d, prefix_sizes,device):

    N_u = label_2d.shape[0]
    K = len(prefix_sizes)

    neg_idx = torch.full((N_u, K),-1,dtype=torch.long,device=device )

    valid = torch.zeros(
        (N_u, K),
        dtype=torch.bool,
        device=device
    )

    for u in range(N_u):

        # Positive / negative personas for this user
        labels_u = label_2d[u].bool()

        non_pos_mask = ~labels_u

        if not non_pos_mask.any():
            continue

        candidates = non_pos_mask.nonzero(
            as_tuple=True
        )[0]

        n_candidates = len(candidates)

        for k, p in enumerate(prefix_sizes):

            # IMPORTANT:
            # use prediction from THIS prefix only
            probs_u = predictions_dict[str(p)][u]

            candidate_probs = probs_u[candidates]

            # Low probability -> easy
            # High probability -> hard
            sorted_order = torch.argsort(
                candidate_probs,
                descending=False
            )

            candidates_sorted = candidates[sorted_order]

            # 64 = easiest
            # 768 = hardest
            if K == 1:
                position = 0
            else:
                position = round(
                    k * (n_candidates - 1) / (K - 1)
                )

            neg_idx[u, k] = candidates_sorted[position]
            valid[u, k] = True

    return neg_idx, valid
