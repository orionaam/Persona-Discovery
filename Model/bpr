def mrl_bpr_multilabel(z_u,z_c,label_2d,neg_idx_all,valid,decay=1e-4):
    
    K = len(NESTING_LIST)

    total_loss = 0.0
    w_d = 1.0 / K

    # Positive (user, persona) pairs
    pos_users, pos_items = (label_2d > 0).nonzero(as_tuple=True)

    for k, d in enumerate(NESTING_LIST):

        # Keep only users for which a valid negative
        # was found at this prefix
        valid_pos = valid[pos_users, k]

        if not valid_pos.any():
            continue

        pu = pos_users[valid_pos]
        pi = pos_items[valid_pos]

        # Prefix embeddings
        z_u_d = z_u[:, :d]
        z_c_d = z_c[:, :d]

        u_emb = z_u_d[pu]
        pos_emb = z_c_d[pi]

        # Prefix-specific negative persona
        neg_emb = z_c_d[neg_idx_all[pu, k]]

        # Scores
        pos_scores = (u_emb * pos_emb).sum(dim=-1)
        neg_scores = (u_emb * neg_emb).sum(dim=-1)

        # BPR loss
        loss_k = F.softplus(neg_scores - pos_scores).mean()
        total_loss += w_d * loss_k

    # L2 regularization
    # reg_loss = (z_u.norm(2).pow(2) +z_c.norm(2).pow(2)) / z_u.shape[0]

    # total_loss += decay * reg_loss

    return total_loss
